<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QuizApp</a>
        <button title="Navigation menu"
                class="navbar-toggler"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable"
     @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Acasă
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link w-100 text-start text-white"
                    @onclick="ToggleAlgebra">
                Algebra
                <span class="float-end">
                    @(isAlgebraExpanded ? "▼" : "▶")
                </span>
            </button>
        </div>

        @if (isAlgebraExpanded)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link ps-4"
                         href="algebra">
                    Pătrate perfecte
                </NavLink>
            </div>
        }


        <div class="nav-item px-3">
            <NavLink class="nav-link" href="geometry">
                Geometrie
            </NavLink>
        </div>        
        
        
        
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool isAlgebraExpanded = false;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    
    private void ToggleAlgebra()
    {
        isAlgebraExpanded = !isAlgebraExpanded;
    }

}

