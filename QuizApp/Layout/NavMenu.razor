<div class="nav-header">
    <a class="brand" href="" @onclick="CloseNavMenu">
        QuizApp
    </a>

    <button class="menu-toggle"
            type="button"
            aria-label="Meniu de navigare"
            aria-expanded="@(!isMenuCollapsed)"
            @onclick="ToggleNavMenu">
        <span></span>
        <span></span>
        <span></span>
    </button>
</div>

<nav class="navigation @MenuCssClass">
    <NavLink class="nav-link"
             href=""
             Match="NavLinkMatch.All"
             @onclick="CloseNavMenu">
        Acasă
    </NavLink>

    <button class="nav-link category"
            type="button"
            aria-expanded="@isAlgebraExpanded"
            @onclick="ToggleAlgebra">
        Algebra
        <span>@(isAlgebraExpanded ? "▾" : "▸")</span>
    </button>

    @if (isAlgebraExpanded)
    {
        <NavLink class="nav-link subcategory"
                 href="algebra/perfect-squares"
                 @onclick="CloseNavMenu">
            Pătrate perfecte
        </NavLink>
    }

    <NavLink class="nav-link"
             href="geometry"
             @onclick="CloseNavMenu">
        Geometrie
    </NavLink>
</nav>

@code {
    private bool isMenuCollapsed = true;
    private bool isAlgebraExpanded = true;

    private string MenuCssClass =>
        isMenuCollapsed ? "collapsed" : string.Empty;

    private void ToggleNavMenu()
    {
        isMenuCollapsed = !isMenuCollapsed;
    }

    private void CloseNavMenu()
    {
        isMenuCollapsed = true;
    }

    private void ToggleAlgebra()
    {
        isAlgebraExpanded = !isAlgebraExpanded;
    }
}